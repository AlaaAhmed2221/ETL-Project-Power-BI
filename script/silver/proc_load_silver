CREATE OR ALTER PROCEDURE silver.load_silver AS
BEGIN
    DECLARE @start_time DATETIME, @end_time DATETIME, @batch_start_time DATETIME, @batch_end_time DATETIME; 
    BEGIN TRY
        SET @batch_start_time = GETDATE();
        PRINT '================================================';
        PRINT 'Loading Silver Layer';
        PRINT '================================================';

set @start_time=GETDATE()
print'>>Truncating Table:silver.Person_Person'
truncate table silver.Person_Person
print'>> inserting data into:silver.Person_Person'
insert into silver.Person_Person(
	BusinessEntityID,
	PersonType,
	Title,
	FirstName,
	LastName,
	Suffix,
	EmailPromotion
)
select
	BusinessEntityID,
	PersonType,
    CASE 
        WHEN UPPER(TRIM(REPLACE(Title, '.', ''))) IN ('MR', 'SR') THEN 'Mr.'
        WHEN UPPER(TRIM(REPLACE(Title, '.', ''))) IN ('MRS', 'SRA') THEN 'Mrs.'
        WHEN UPPER(TRIM(REPLACE(Title, '.', ''))) IN ('MS', 'MISS') THEN 'Ms.'
        WHEN Title IS NULL OR TRIM(Title) = '' THEN NULL
        ELSE CONCAT(UPPER(LEFT(TRIM(Title), 1)), LOWER(SUBSTRING(TRIM(Title), 2, LEN(Title))))
    END AS Title,
	FirstName,
	LastName,
	Suffix,
	EmailPromotion
from bronze.Person_Person
SET @end_time = GETDATE();
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(SECOND, @start_time, @end_time) AS NVARCHAR) + ' seconds';
        PRINT '>> -------------';


set @start_time=GETDATE()
print'>>Truncating Table:silver.Production_Product'
truncate table silver.Production_Product
print'>> inserting data into:silver.Production_Product'
insert into silver.Production_Product(
	ProductID,
	name,
	ProductNumber,
	MakeFlag,
	FinishedGoodsFlag,
	Color,
	SafetyStockLevel,
	ReorderPoint,
	StandardCost,
	ListPrice,
	Size,
	SizeUnitMeasureCode,
	WeightUnitMeasureCode,
	Weight,
	DaysToManufacture,
	ProductLine,
	Class,
	Style,
	ProductSubcategoryID,
	SellStartDate,
	SellEndDate,
	DiscontinuedDate
)
select
	ProductID,
	name,
	ProductNumber,
	MakeFlag,
	FinishedGoodsFlag,
	Color,
	SafetyStockLevel,
	ReorderPoint,
	StandardCost,
	ListPrice,
	Size,
	SizeUnitMeasureCode,
	WeightUnitMeasureCode,
	Weight,
	DaysToManufacture,
	ProductLine,
	Class,
	Style,
	ProductSubcategoryID,
	SellStartDate,
