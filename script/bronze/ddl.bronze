------DDL BROZE LAyER----------

--------Human_Resources-------------
IF OBJECT_ID('bronze.HR_departments', 'U') IS NOT NULL
    DROP TABLE bronze.HR_departments;

create table bronze.HR_departments(
	departmentID smallint,
	name varchar(50),
	groupName varchar(50),
	modifiedDate datetime
)
GO

IF OBJECT_ID('bronze.HR_employee', 'U') IS NOT NULL
    DROP TABLE bronze.HR_employee;
GO

CREATE TABLE bronze.HR_employee (
    BusinessEntityID    INT           ,
    NationalIDNumber    NVARCHAR(15)  ,
    LoginID             NVARCHAR(256) ,
    OrganizationNode    HIERARCHYID   ,
    OrganizationLevel   SMALLINT      ,
    JobTitle            NVARCHAR(50)  ,
    BirthDate           DATE          ,
    MaritalStatus       NCHAR(1)      ,
    Gender              NCHAR(1)      ,
    HireDate            DATE          ,
    SalariedFlag        BIT           ,
    VacationHours       SMALLINT      ,
    SickLeaveHours      SMALLINT      ,
    CurrentFlag         BIT           ,
    rowguid             UNIQUEIDENTIFIER ,
    ModifiedDate        DATETIME      
)
GO

IF OBJECT_ID('bronze.HR_employeeDepartmentHistory', 'U') IS NOT NULL
    DROP TABLE bronze.HR_employeeDepartmentHistory;
GO

CREATE TABLE bronze.HR_employeeDepartmentHistory (
    BusinessEntityID    INT           ,
    DepartmentID        SMALLINT      ,
    ShiftID             TINYINT       ,
    StartDate           DATE          ,
    EndDate             DATE          ,
    ModifiedDate        DATETIME      
);
GO

IF OBJECT_ID('bronze.HR_employeePayHistory', 'U') IS NOT NULL
    DROP TABLE bronze.HR_employeePayHistory;
GO

CREATE TABLE bronze.HR_employeePayHistory (
    BusinessEntityID    INT           ,
    RateChangeDate      DATETIME      ,
    Rate                MONEY         ,
    PayFrequency        TINYINT       ,
    ModifiedDate        DATETIME      
);
GO

IF OBJECT_ID('bronze.HR_jobCandidate', 'U') IS NOT NULL
    DROP TABLE bronze.HR_jobCandidate;
GO

CREATE TABLE bronze.HR_jobCandidate (
    JobCandidateID      INT           ,
    BusinessEntityID    INT           ,
    Resume              XML           ,
    ModifiedDate        DATETIME      
);
GO

IF OBJECT_ID('bronze.HR_shift', 'U') IS NOT NULL
    DROP TABLE bronze.HR_shift;
GO

CREATE TABLE bronze.HR_shift (
    ShiftID             TINYINT       ,
    Name                NVARCHAR(50)  ,
    StartTime           TIME          ,
    EndTime             TIME          ,
    ModifiedDate        DATETIME      
);
GO


