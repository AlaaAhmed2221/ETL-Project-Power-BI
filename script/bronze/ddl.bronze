    PurchaseOrderDetailID INT,
    DueDate DATETIME,
    OrderQty SMALLINT,
    ProductID INT,
    UnitPrice MONEY,
    LineTotal MONEY,
    ReceivedQty DECIMAL(8, 2),
    RejectedQty DECIMAL(8, 2),
    StockedQty AS (ReceivedQty - RejectedQty),
